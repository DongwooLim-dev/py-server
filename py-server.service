[Unit]
Description=FastAPI and Streamlit task app
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/py-server
ExecStart=/home/azureuser/py-server/.venv/bin/python run.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target
